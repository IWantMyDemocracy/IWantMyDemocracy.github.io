---
import { Image, Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import DesignCard from '../../components/DesignCard.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Icon from '../../components/Icon.astro';
import { getCauses, getDesigns, causesOf, storeLinks, type Design } from '../../lib/catalog';

export async function getStaticPaths() {
  const designs = await getDesigns();
  return designs.map((design) => ({ params: { slug: design.id }, props: { design } }));
}

const { design } = Astro.props as { design: Design };
const allCauses = await getCauses();
const designs = await getDesigns();
const causes = causesOf(design, allCauses);
const pageUrl = new URL(`/designs/${design.id}`, Astro.site).toString();

// One "view" per colour (or just the main picture). Picking a colour swaps the picture and
// points the shop buttons at that colour's listing; a store's button is hidden for colours
// that store doesn't sell.
const hasColors = design.colorways.length > 1;
const colorSlug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
// White artwork is shown on navy (as the stores do) so it doesn't disappear on the light background.
const onDark = (name: string) => /^white$/i.test(name.trim());
const views = hasColors
  ? design.colorways.map((c) => ({
      name: c.name,
      slug: colorSlug(c.name),
      image: c.image,
      dark: onDark(c.name),
      links: storeLinks(design, c),
    }))
  : [{ name: '', slug: '', image: design.image, dark: false, links: storeLinks(design) }];
const links = views[0].links;
const sells = {
  teepublic: views.some((v) => v.links.teepublic),
  redbubble: views.some((v) => v.links.redbubble),
};

// "More from this cause": same causes first, then other designs, never this one.
const related = [
  ...designs.filter((d) => d.id !== design.id && d.causeKeys.some((k) => design.causeKeys.includes(k))),
  ...designs.filter((d) => d.id !== design.id && !d.causeKeys.some((k) => design.causeKeys.includes(k))),
].slice(0, 4);
const description =
  design.description ||
  `"${design.title}" by I Want My Democracy. Available on T-shirts, hoodies, hats, mugs, stickers and more.`;
---

<Base title={design.title} description={description} ogImage={`/og/${design.id}.png`}>
  <section class="design-hero">
    <div class="container design-layout">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/designs">All designs</a>
        {
          causes[0] && (
            <>
              <span aria-hidden="true">/</span>
              <a href={`/causes/${causes[0].id}`}>{causes[0].name}</a>
            </>
          )
        }
      </nav>

      <div class="design-image">
        {
          views.map((v, i) => (
            <div class:list={['design-view', { 'on-dark': v.dark }]} data-color-view={i} hidden={i > 0}>
              <Picture
                src={v.image}
                alt={v.name ? `${design.title}, ${v.name}` : design.title}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[400, 640, 900, 1200]}
                sizes="(max-width: 860px) 92vw, 560px"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
            </div>
          ))
        }
      </div>

      <div class="design-info">
        {
          causes.length > 0 && (
            <ul class="design-causes">
              {causes.map((c) => (
                <li>
                  <a class="chip" href={`/causes/${c.id}`}>
                    {c.name}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <h1>{design.title}</h1>
        {design.description && <p class="design-desc">{design.description}</p>}
        <p class="design-products">
          Available on T-shirts, hoodies, hats, mugs, pillows, phone cases, stickers, magnets and more. Choose your
          product, size and color on the store.
        </p>

        {
          hasColors && (
            <div class="colors">
              <p class="colors-label">
                Color: <strong data-color-name>{views[0].name}</strong>
                <span class="colors-count">({views.length} colors)</span>
              </p>
              <div class="swatches" role="radiogroup" aria-label="Choose a color">
                {views.map((v, i) => (
                  <button
                    type="button"
                    class:list={['swatch', { 'on-dark': v.dark }]}
                    role="radio"
                    aria-checked={i === 0 ? 'true' : 'false'}
                    aria-label={v.name}
                    title={v.name}
                    data-swatch={i}
                    data-name={v.name}
                    data-slug={v.slug}
                    data-teepublic={v.links.teepublic}
                    data-redbubble={v.links.redbubble}
                  >
                    <Image src={v.image} alt="" width={120} loading="lazy" />
                  </button>
                ))}
              </div>
            </div>
          )
        }

        {
          (sells.teepublic || sells.redbubble) && (
            <div class="design-buy">
              {sells.teepublic && (
                <a
                  class="btn btn-lg"
                  href={links.teepublic || undefined}
                  hidden={!links.teepublic}
                  target="_blank"
                  rel="noopener"
                  data-buy="teepublic"
                >
                  Shop on TeePublic <Icon name="external" class="ext" />
                </a>
              )}
              {sells.redbubble && (
                <a
                  class="btn btn-lg"
                  href={links.redbubble || undefined}
                  hidden={!links.redbubble}
                  target="_blank"
                  rel="noopener"
                  data-buy="redbubble"
                >
                  Shop on Redbubble <Icon name="external" class="ext" />
                </a>
              )}
            </div>
          )
        }

        <ShareButtons url={pageUrl} title={design.title} />
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section-tint">
        <div class="container">
          <div class="section-head">
            <div>
              <span class="eyebrow">Keep browsing</span>
              <h2>{causes[0] ? `More from ${causes[0].name}` : 'More designs'}</h2>
            </div>
            {causes[0] && (
              <a class="link-arrow" href={`/causes/${causes[0].id}`}>
                See all
              </a>
            )}
          </div>
          <div class="design-grid">
            {related.map((d) => (
              <DesignCard design={d} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<script>
  const swatches = [...document.querySelectorAll<HTMLButtonElement>('[data-swatch]')];
  const views = [...document.querySelectorAll<HTMLElement>('[data-color-view]')];
  const nameEl = document.querySelector<HTMLElement>('[data-color-name]');
  const buy = {
    teepublic: document.querySelector<HTMLAnchorElement>('[data-buy="teepublic"]'),
    redbubble: document.querySelector<HTMLAnchorElement>('[data-buy="redbubble"]'),
  };

  function choose(btn: HTMLButtonElement, updateUrl = true) {
    const index = btn.dataset.swatch;
    swatches.forEach((s) => s.setAttribute('aria-checked', String(s === btn)));
    views.forEach((v) => (v.hidden = v.dataset.colorView !== index));
    if (nameEl) nameEl.textContent = btn.dataset.name ?? '';
    // Show a store's button only when that store sells the chosen colour.
    for (const store of ['teepublic', 'redbubble'] as const) {
      const link = buy[store];
      const href = btn.dataset[store];
      if (!link) continue;
      link.hidden = !href;
      if (href) link.href = href;
    }
    if (updateUrl) {
      const url = new URL(location.href);
      if (index === '0') url.searchParams.delete('color');
      else url.searchParams.set('color', btn.dataset.slug ?? '');
      history.replaceState(null, '', url);
    }
  }

  swatches.forEach((btn) => btn.addEventListener('click', () => choose(btn)));

  // Arrow keys move between colours, like other radio buttons.
  swatches.forEach((btn, i) =>
    btn.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = swatches[(i + step + swatches.length) % swatches.length];
      next.focus();
      choose(next);
    })
  );

  // Links like /designs/fight-fascism?color=lime-green open on that colour.
  const wanted = new URLSearchParams(location.search).get('color');
  const start = swatches.find((s) => wanted && s.dataset.slug === wanted);
  if (start) choose(start, false);
</script>

<style>
  .design-hero {
    background: linear-gradient(180deg, var(--tint) 0%, var(--white) 70%);
    padding-block: 24px clamp(40px, 6vw, 72px);
  }
  .design-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'crumbs crumbs'
      'image info';
    gap: 18px clamp(24px, 5vw, 56px);
    align-items: start;
  }
  .crumbs {
    grid-area: crumbs;
    display: flex;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .design-image {
    grid-area: image;
    position: relative;
    aspect-ratio: 1;
    border-radius: calc(var(--radius) * 1.4);
    background: radial-gradient(circle at 50% 42%, var(--white) 0%, var(--tint) 78%);
    box-shadow: var(--shadow-lg);
    border: 6px solid var(--white);
  }
  .design-view[hidden] {
    display: none;
  }
  .design-view.on-dark {
    position: absolute;
    inset: 0;
    background: var(--navy);
    border-radius: calc(var(--radius) * 1.4 - 6px);
  }
  .swatch.on-dark,
  .swatch.on-dark[aria-checked='true'] {
    background: var(--navy);
  }
  .design-image :global(img) {
    position: absolute;
    inset: 7%;
    width: 86%;
    height: 86%;
    object-fit: contain;
    filter: drop-shadow(0 6px 14px rgb(11 31 77 / 0.14));
  }
  .design-info {
    grid-area: info;
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .design-info h1 {
    color: var(--royal);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    margin: 0;
  }
  .design-causes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .design-desc {
    font-size: 1.15rem;
    margin: 0;
  }
  .design-products {
    color: var(--ink-soft);
    margin: 0;
  }
  .colors-label {
    margin: 0 0 10px;
    font-weight: 700;
  }
  .colors-label strong {
    color: var(--royal);
  }
  .colors-count {
    color: var(--ink-soft);
    font-weight: 600;
    margin-left: 4px;
  }
  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .swatch {
    width: 64px;
    height: 64px;
    padding: 4px;
    border-radius: var(--radius-sm);
    border: 2px solid var(--tint-2);
    background: var(--tint);
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .swatch:hover {
    border-color: var(--royal);
    transform: translateY(-1px);
  }
  .swatch[aria-checked='true'] {
    border-color: var(--royal);
    box-shadow: 0 0 0 2px var(--white), 0 0 0 4px var(--royal);
    background: var(--white);
  }
  .swatch :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .design-buy {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 18px 0;
    border-block: 1px solid var(--tint-2);
  }
  @media (max-width: 860px) {
    .design-layout {
      grid-template-columns: 1fr;
      grid-template-areas: 'crumbs' 'image' 'info';
    }
    .design-buy .btn {
      flex: 1 1 100%;
    }
  }
</style>
