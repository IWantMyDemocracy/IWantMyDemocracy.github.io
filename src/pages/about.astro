---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import EmailButton from '../components/EmailButton.astro';
import Icon from '../components/Icon.astro';
import donkey from '../assets/brand/donkey.png';
import { redbubbleShopUrl, teepublicShopUrl, settings } from '../lib/catalog';

// The About text is typed in the editor; a blank line starts a new paragraph.
const paragraphs = (settings.aboutText || '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<Base title="About" description={settings.aboutShort}>
  <PageBanner eyebrow="Our story" title="About I Want My Democracy" />

  <section class="section section-white">
    <div class="container about-layout">
      <div class="about-text">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <aside class="about-side">
        <Image src={donkey} alt="Our mascot, the blue donkey, kickin' it" widths={[240, 360, 480]} sizes="240px" />
      </aside>
    </div>
  </section>

  <section class="section section-tint" id="contact">
    <div class="container contact">
      <h2>Get in touch</h2>
      <p>Questions about an order are best answered by the store you bought from. For anything else, we'd love to hear from you.</p>
      <div class="contact-actions">
        <EmailButton />
        {
          settings.teepublicStore && (
            <a class="btn btn-white" href={teepublicShopUrl()} target="_blank" rel="noopener">
              TeePublic store <Icon name="external" class="ext" />
            </a>
          )
        }
        {
          settings.redbubbleStore && (
            <a class="btn btn-white" href={redbubbleShopUrl()} target="_blank" rel="noopener">
              Redbubble store <Icon name="external" class="ext" />
            </a>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(24px, 6vw, 72px);
    align-items: start;
    max-width: 980px;
  }
  .about-text {
    font-size: 1.15rem;
  }
  .about-side :global(img) {
    width: 220px;
    height: auto;
  }
  .contact {
    max-width: 760px;
  }
  .contact h2 {
    color: var(--royal);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 700px) {
    .about-layout {
      grid-template-columns: 1fr;
    }
    .about-side {
      order: -1;
    }
    .about-side :global(img) {
      width: 140px;
    }
  }
</style>
